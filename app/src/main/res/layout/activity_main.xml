<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.ivangames.trolljump.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnLeft"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:text="◀"
            android:textSize="24sp"
            android:backgroundTint="#66808080"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRight"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:text="▶"
            android:textSize="24sp"
            android:backgroundTint="#66808080"
            android:textColor="#FFFFFF"
            android:layout_marginStart="12dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnJump"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:text="⬆"
            android:textSize="24sp"
            android:backgroundTint="#66FFC107"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- Оверлей победы -->
    <FrameLayout
        android:id="@+id/winOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆"
                android:textSize="72sp" />

            <TextView
                android:id="@+id/winText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Уровень 1 пройден!"
                android:textColor="#FFC107"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/winBackBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="К УРОВНЯМ"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32"
                android:padding="20dp"
                android:layout_marginTop="32dp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
